#!/usr/bin/env python3
"""Launch Codex with this adjacent config without overwriting the user's config."""

import json
import os
from pathlib import Path
import sys
import tomllib


def command(config_path, arguments):
    config_path = Path(config_path).resolve()
    config = tomllib.loads(config_path.read_text())
    overrides = []

    def flatten(table, prefix=''):
        for key, value in table.items():
            name = f'{prefix}.{key}' if prefix else key
            if isinstance(value, dict):
                flatten(value, name)
            else:
                if key == 'config_file':
                    value = str((config_path.parent / value).resolve())
                    if not Path(value).is_file():
                        raise ValueError(f'Agent config not found: {value}')
                overrides.extend(['-c', f'{name}={json.dumps(value)}'])

    flatten(config)
    return ['codex', *overrides, *arguments]


if __name__ == '__main__':
    arguments = sys.argv[1:]
    preview = arguments[:1] == ['--print-command']
    if preview:
        arguments = arguments[1:]
    try:
        argv = command(Path(__file__).resolve().with_name('chief-of-staff.config.toml'), arguments)
        if preview:
            print(json.dumps(argv))
        else:
            os.execvp(argv[0], argv)
    except (OSError, ValueError, tomllib.TOMLDecodeError) as error:
        sys.exit(f'Cannot launch Chief of Staff: {error}')
